# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database

# JWT Secret for Authentication
JWT_SECRET=your-secure-random-secret-key-here

# Instagram OAuth (deprecated for new apps)
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=https://your-domain.com/callback/instagram

# TikTok OAuth
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://your-domain.com/callback/tiktok

# YouTube OAuth
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=https://your-domain.com/callback/youtube
YOUTUBE_API_KEY=your_youtube_api_key

# AI Services for Collaborator Matching
# Option 1: Anthropic Claude (Recommended)
ANTHROPIC_API_KEY=

# Option 2: OpenAI GPT-4 (Fallback)
OPENAI_API_KEY=

# Server Configuration
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-domain.vercel.app
